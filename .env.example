# Database (Neon / any Postgres) — required for sites & auth sync
DATABASE_URL="postgresql://user:password@localhost:5432/websitebuildersaas?schema=public"

# Clerk — https://dashboard.clerk.com → Create application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/agency
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/agency

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI draft (OpenAI or Anthropic)
OPENAI_API_KEY=

# Humanize (pick one; never use same vendor for detect)
PHRASLY_API_KEY=
REWRITEAI_API_KEY=
HUMANIZER_PROVIDER=phrasly

# Independent detect / plagiarism
COPYLEAKS_API_KEY=
COPYLEAKS_EMAIL=

# Optional Grammarly polish only
GRAMMARLY_CLIENT_ID=
GRAMMARLY_CLIENT_SECRET=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Geocoding
GEOCODE_PROVIDER=nominatim

# Lightsail deploy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
